{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "OpenRouter Meter",
  "version": "0.3.0",
  "identifier": "ai.openrouter.widget",
  "build": {
    "frontendDist": "../dist/renderer"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "OpenRouter Meter",
        "width": 320,
        "height": 240,
        "minWidth": 180,
        "minHeight": 120,
        "decorations": false,
        "transparent": false,
        "shadow": true,
        "resizable": true,
        "maximizable": true,
        "minimizable": true,
        "fullscreen": false,
        "skipTaskbar": true,
        "visible": false,
        "alwaysOnTop": true,
        "acceptFirstMouse": true
      }
    ],
    "security": {
      "csp": "default-src 'none'; script-src 'self'; style-src 'self'; img-src 'self' data:; font-src 'self'; connect-src 'none'; form-action 'none'; base-uri 'none'"
    },
    "macOSPrivateApi": true
  },
  "bundle": {
    "active": true,
    "targets": [
      "dmg"
    ],
    "icon": [
      "icons/icon.png"
    ],
    "macOS": {
      "minimumSystemVersion": "12.0"
    }
  },
  "mainBinaryName": "OpenRouter Meter"
}
